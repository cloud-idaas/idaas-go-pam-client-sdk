  "requestRules": {
    "expiration": {
      "kind": "integer",
      "unit": "seconds",
      "minimum": 1,
      "maximum": 315360000,
      "omitted": "service default"
    },
    "customClaims": {
      "kind": "object",
      "maximumUtf8JsonBytes": 16384,
      "omitted": "omit field",
      "emptyObject": "send empty object"
    },
    "maxResults": {
      "kind": "int64",
      "minimum": 1,
      "omitted": "service default"
    },
    "optionalBoolean": {
      "fields": [
        "includeDerivedShortToken",
        "revoked",
        "expired"
      ],
      "omitted": "omit field",
      "explicitFalse": "send false"
    },
    "tokenTypeHint": {
      "wireName": "token_type_hint",
      "omitted": "omit field",
      "provided": "nonblank string"
    }
  },
  "responseRules": {
    "integers": "signed int64 without floating-point conversion",
    "timestampUnits": {
      "createTime": "Unix milliseconds",
      "updateTime": "Unix milliseconds",
      "expirationTime": "Unix milliseconds",
      "accessCredentialExpiresAt": "Unix seconds",
      "expiredTime": "Unix seconds"
    },
    "invalidResponse": {
      "coreType": "CredentialError",
      "errorCode": "InvalidResponse",
      "requestId": "retain service request ID when available"
    },
    "apiKey": {
      "explicitApiKeyContentNull": "nil result without error",
      "missingOrInvalidBusinessField": "InvalidResponse"
    },
    "tokenValidation": {
      "activeFalse": "false result without error",
      "missingOrNonbooleanActive": "InvalidResponse"
    },
    "pagination": {
      "emptyEntities": "non-nil empty slice",
      "missingEntities": "allowed only with totalCount=0, a valid maxResults, and no next page",
      "nullEntities": "InvalidResponse",
      "nextTokenEnd": [
        "absent",
        "null",
        "empty string"
      ]
    },
    "unknownFields": "ignore",
    "jsonDecodingFailure": {
      "coreType": "EncodingError",
      "errorCode": "DecodeFailed",
      "requestId": "retain service request ID when available"
    }
  }
